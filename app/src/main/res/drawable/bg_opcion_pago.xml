<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/naranja_suave" />
            <corners android:radius="@dimen/radio_esquina" />
            <stroke
                android:width="@dimen/borde_seleccion"
                android:color="@color/naranja_primario" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <corners android:radius="@dimen/radio_esquina" />
            <stroke
                android:width="@dimen/borde_fino"
                android:color="@color/borde" />
        </shape>
    </item>
</selector>
