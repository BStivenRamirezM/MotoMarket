<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_xl">

    <TextView
        style="@style/MotoMarket.Text.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/registro_vender_aviso" />

    <TextView
        style="@style/MotoMarket.Label"
        android:text="@string/campo_nombre_negocio" />

    <EditText
        android:id="@+id/etNombreTienda"
        style="@style/MotoMarket.Campo"
        android:drawableStart="@drawable/ic_store"
        android:hint="@string/hint_nombre_negocio"
        android:importantForAutofill="no"
        android:inputType="textCapWords" />

</LinearLayout>
