<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/titulo_servicio_tecnico" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_l">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNumero"
                            style="@style/MotoMarket.Text.Subtitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvEstado"
                            style="@style/MotoMarket.Chip" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvContraparte"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:drawablePadding="@dimen/espacio_s"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_build"
                        app:drawableTint="@color/naranja_primario" />

                    <TextView
                        android:id="@+id/tvMoto"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:drawablePadding="@dimen/espacio_s"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_moto"
                        app:drawableTint="@color/naranja_primario" />

                    <TextView
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:text="@string/campo_falla" />

                    <TextView
                        android:id="@+id/tvFalla"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvFecha"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s" />

                    <TextView
                        android:id="@+id/tvNota"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRefPago"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        style="@style/MotoMarket.Text.Subtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/servicio_cotizacion" />

                    <TextView
                        android:id="@+id/tvAyudaCotizacion"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs" />

                    <LinearLayout
                        android:id="@+id/contenedorLineas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btnAgregarLinea"
                        style="@style/MotoMarket.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:text="@string/servicio_agregar_linea"
                        android:visibility="gone"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@color/naranja_oscuro" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/borde_fino"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:layout_marginBottom="@dimen/espacio_m"
                        android:background="@color/borde" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/MotoMarket.Text.Subtitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/carrito_total" />

                        <TextView
                            android:id="@+id/tvTotal"
                            style="@style/MotoMarket.Text.Precio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/texto_titulo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/naranja_primario"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espacio_l"
        android:paddingEnd="@dimen/espacio_l"
        android:paddingBottom="@dimen/espacio_l">

        <Button
            android:id="@+id/btnPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSecundario"
            style="@style/MotoMarket.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
