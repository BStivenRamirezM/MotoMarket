<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <LinearLayout
        android:id="@+id/bannerSolicitar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/espacio_l"
        android:background="@drawable/bg_banner_oscuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_l"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icono_l"
            android:layout_height="@dimen/icono_l"
            android:contentDescription="@null"
            android:src="@drawable/ic_build"
            app:tint="@color/naranja_primario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/servicios_banner_titulo"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_m"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/servicios_banner_detalle"
                android:textColor="@color/naranja_claro"
                android:textSize="@dimen/texto_s" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSolicitarServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_l"
        android:layout_marginEnd="@dimen/espacio_l"
        android:text="@string/servicios_solicitar"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServicios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/espacio_m"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/naranja_primario"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSinServicios"
            style="@style/MotoMarket.Text.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/espacio_xl"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
