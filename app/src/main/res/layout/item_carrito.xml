<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_m">

        <ImageView
            android:layout_width="@dimen/miniatura_item"
            android:layout_height="@dimen/miniatura_item"
            android:background="@drawable/bg_icono_suave"
            android:contentDescription="@null"
            android:padding="@dimen/espacio_m"
            android:src="@drawable/ic_moto"
            app:tint="@color/naranja_primario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/MotoMarket.Text.Nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCantidadPrecio"
                style="@style/MotoMarket.Text.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_eliminar_producto"
            android:src="@drawable/ic_delete"
            app:tint="@color/chip_rojo_texto" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
