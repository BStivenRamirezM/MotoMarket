<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_l">

        <ImageView
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="@drawable/bg_icono_suave"
            android:contentDescription="@null"
            android:padding="@dimen/espacio_m"
            android:src="@drawable/ic_build"
            app:tint="@color/naranja_primario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                style="@style/MotoMarket.Text.Nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDetalle"
                style="@style/MotoMarket.Text.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs" />

            <TextView
                android:id="@+id/tvTotal"
                style="@style/MotoMarket.Text.Precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            style="@style/MotoMarket.Chip" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
