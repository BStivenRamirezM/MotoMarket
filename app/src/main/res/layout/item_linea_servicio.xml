<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/espacio_s"
    android:paddingBottom="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/espacio_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescripcion"
            style="@style/MotoMarket.Text.Nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvCantidadPrecio"
            style="@style/MotoMarket.Text.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtotal"
        style="@style/MotoMarket.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="@dimen/avatar"
        android:layout_height="@dimen/avatar"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_eliminar_linea"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="@color/chip_rojo_texto" />

</LinearLayout>
