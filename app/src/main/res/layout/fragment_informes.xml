<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/titulo_informes" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_m">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/espacio_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        style="@style/MotoMarket.Text.Subtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/informes_que_consultar" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView
                        android:id="@+id/tvDescripcionTipo"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs" />

                    <TextView
                        style="@style/MotoMarket.Label"
                        android:text="@string/informes_periodo" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsPeriodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEsteMes"
                            style="@style/MotoMarket.ChipCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/periodo_este_mes" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip30Dias"
                            style="@style/MotoMarket.ChipCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_30_dias" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip3Meses"
                            style="@style/MotoMarket.ChipCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_3_meses" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEsteAnio"
                            style="@style/MotoMarket.ChipCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_este_anio" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPersonalizado"
                            style="@style/MotoMarket.ChipCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_personalizado" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/tvRango"
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs" />

                    <Button
                        android:id="@+id/btnGenerar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_l"
                        android:text="@string/informes_generar"
                        app:icon="@drawable/ic_bar_chart"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/espacio_l"
                android:indeterminateTint="@color/naranja_primario"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenedorResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTituloInforme"
                    style="@style/MotoMarket.Text.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:layout_marginTop="@dimen/espacio_l" />

                <TextView
                    android:id="@+id/tvRangoInforme"
                    style="@style/MotoMarket.Text.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:layout_marginBottom="@dimen/espacio_s" />

                <LinearLayout
                    android:id="@+id/contenedorIndicadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/espacio_xs">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_s">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/contenedorTabla"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/tvSinDatos"
                            style="@style/MotoMarket.Text.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/espacio_m"
                            android:text="@string/informes_sin_datos"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvFilasOcultas"
                            style="@style/MotoMarket.Text.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/espacio_s"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btnExportar"
                    style="@style/MotoMarket.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/espacio_xs"
                    android:text="@string/informes_exportar"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/naranja_oscuro" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
