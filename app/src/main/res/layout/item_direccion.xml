<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_l">

        <ImageView
            android:layout_width="@dimen/icono_m"
            android:layout_height="@dimen/icono_m"
            android:contentDescription="@null"
            android:src="@drawable/ic_location"
            app:tint="@color/naranja_primario" />

        <TextView
            android:id="@+id/tvDireccion"
            style="@style/MotoMarket.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
