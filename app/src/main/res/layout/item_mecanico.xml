<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s"
    android:background="@drawable/bg_opcion_pago"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_m">

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="@dimen/avatar"
        android:layout_height="@dimen/avatar"
        android:background="@drawable/bg_circulo_naranja"
        android:gravity="center"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_m"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaller"
            style="@style/MotoMarket.Text.Nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDetalle"
            style="@style/MotoMarket.Text.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvElegir"
        style="@style/MotoMarket.Text.Enlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
