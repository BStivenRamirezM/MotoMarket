<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/titulo_recuperar_password" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/espacio_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_xl">

            <ImageView
                android:layout_width="@dimen/circulo_huella"
                android:layout_height="@dimen/circulo_huella"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circulo_suave"
                android:contentDescription="@null"
                android:padding="@dimen/espacio_l"
                android:src="@drawable/ic_lock"
                app:tint="@color/naranja_primario" />

            <TextView
                style="@style/MotoMarket.Text.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:gravity="center"
                android:text="@string/recuperar_titulo" />

            <TextView
                style="@style/MotoMarket.Text.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:gravity="center"
                android:text="@string/recuperar_descripcion" />

            <TextView
                style="@style/MotoMarket.Label"
                android:text="@string/campo_correo" />

            <EditText
                android:id="@+id/etCorreo"
                style="@style/MotoMarket.Campo"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_email"
                android:hint="@string/hint_correo"
                android:inputType="textEmailAddress" />

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_m"
                android:indeterminateTint="@color/naranja_primario"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xl"
                android:text="@string/recuperar_enviar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
