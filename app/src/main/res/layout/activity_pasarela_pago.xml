<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/titulo_pago" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/espacio_l"
            android:paddingEnd="@dimen/espacio_l"
            android:paddingBottom="@dimen/espacio_l">

            <TextView
                style="@style/MotoMarket.Text.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:text="@string/pago_direccion_entrega" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <LinearLayout
                        android:id="@+id/btnUsarUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_opcion_pago"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/espacio_m">

                        <TextView
                            style="@style/MotoMarket.Text.Nombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pago_ubicacion_gps" />

                        <ProgressBar
                            android:id="@+id/progresoUbicacion"
                            android:layout_width="@dimen/icono_m"
                            android:layout_height="@dimen/icono_m"
                            android:indeterminateTint="@color/naranja_primario"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        style="@style/MotoMarket.Label"
                        android:text="@string/pago_direccion_manual" />

                    <EditText
                        android:id="@+id/etDireccion"
                        style="@style/MotoMarket.Campo"
                        android:autofillHints="postalAddress"
                        android:drawableStart="@drawable/ic_location"
                        android:hint="@string/hint_direccion"
                        android:inputType="textPostalAddress|textMultiLine"
                        android:maxLines="3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/MotoMarket.Text.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pago_metodo" />

            <LinearLayout
                android:id="@+id/opcionTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_opcion_pago"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_l">

                <ImageView
                    android:layout_width="@dimen/icono_m"
                    android:layout_height="@dimen/icono_m"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_credit_card"
                    app:tint="@color/naranja_primario" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MotoMarket.Text.Nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_tarjeta" />

                    <TextView
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_tarjeta_detalle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvElegirTarjeta"
                    style="@style/MotoMarket.Text.Enlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pago_elegir" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opcionPse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:background="@drawable/bg_opcion_pago"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_l">

                <ImageView
                    android:layout_width="@dimen/icono_m"
                    android:layout_height="@dimen/icono_m"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bank"
                    app:tint="@color/naranja_primario" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MotoMarket.Text.Nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_pse" />

                    <TextView
                        style="@style/MotoMarket.Text.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_pse_detalle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvElegirPse"
                    style="@style/MotoMarket.Text.Enlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pago_elegir" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xl"
                android:background="@drawable/bg_banner_oscuro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_l">

                <ImageView
                    android:layout_width="@dimen/icono_m"
                    android:layout_height="@dimen/icono_m"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/naranja_primario" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_banner_linea1"
                        android:textColor="@color/blanco"
                        android:textSize="@dimen/texto_s" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_banner_linea2"
                        android:textColor="@color/naranja_primario"
                        android:textSize="@dimen/texto_m"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/naranja_primario"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnConfirmarPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/espacio_l" />

</LinearLayout>
