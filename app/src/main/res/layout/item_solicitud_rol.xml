<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/avatar"
                android:layout_height="@dimen/avatar"
                android:background="@drawable/bg_circulo_naranja"
                android:gravity="center"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_m"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_m"
                android:layout_marginEnd="@dimen/espacio_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTienda"
                    style="@style/MotoMarket.Text.Nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvSolicitante"
                    style="@style/MotoMarket.Text.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvFecha"
                    style="@style/MotoMarket.Text.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstado"
                style="@style/MotoMarket.Chip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAprobar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espacio_xs"
                android:layout_weight="1"
                android:text="@string/aprobacion_aprobar" />

            <Button
                android:id="@+id/btnRechazar"
                style="@style/MotoMarket.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_xs"
                android:layout_weight="1"
                android:text="@string/aprobacion_rechazar" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
