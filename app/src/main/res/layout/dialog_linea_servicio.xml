<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_xl">

    <TextView
        style="@style/MotoMarket.Label"
        android:text="@string/campo_descripcion_linea" />

    <EditText
        android:id="@+id/etDescripcion"
        style="@style/MotoMarket.Campo"
        android:hint="@string/hint_descripcion_linea"
        android:importantForAutofill="no"
        android:inputType="textCapSentences" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MotoMarket.Label"
                android:text="@string/campo_cantidad" />

            <EditText
                android:id="@+id/etCantidad"
                style="@style/MotoMarket.Campo"
                android:hint="@string/hint_cantidad"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_s"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                style="@style/MotoMarket.Label"
                android:text="@string/campo_precio_unitario" />

            <EditText
                android:id="@+id/etPrecio"
                style="@style/MotoMarket.Campo"
                android:hint="@string/hint_precio"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
