<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/titulo_mi_tienda" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_l">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/avatar_perfil"
                        android:layout_height="@dimen/avatar_perfil"
                        android:background="@drawable/bg_circulo_naranja"
                        android:contentDescription="@string/cd_logo_tienda"
                        android:padding="@dimen/espacio_xl"
                        android:src="@drawable/ic_store"
                        app:tint="@color/blanco" />

                    <TextView
                        android:id="@+id/tvNombreTienda"
                        style="@style/MotoMarket.Text.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m" />

                    <TextView
                        android:id="@+id/tvCalificacion"
                        style="@style/MotoMarket.Text.Nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/MotoMarket.Text.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_vendedor_datos" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        android:id="@+id/tvTelefono"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/espacio_m"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_phone"
                        app:drawableTint="@color/naranja_primario" />

                    <TextView
                        android:id="@+id/tvCorreo"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:drawablePadding="@dimen/espacio_m"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_email"
                        app:drawableTint="@color/naranja_primario" />

                    <TextView
                        android:id="@+id/tvMiembroDesde"
                        style="@style/MotoMarket.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:drawablePadding="@dimen/espacio_m"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_history"
                        app:drawableTint="@color/naranja_primario" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCerrarSesion"
        style="@style/MotoMarket.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/espacio_l"
        android:text="@string/cerrar_sesion" />

</LinearLayout>
