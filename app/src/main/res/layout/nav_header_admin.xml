<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/alto_header_drawer"
    android:background="@color/naranja_primario"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="@dimen/espacio_l">

    <ImageView
        android:layout_width="@dimen/avatar_perfil"
        android:layout_height="@dimen/avatar"
        android:contentDescription="@string/cd_logo"
        android:scaleType="fitStart"
        android:src="@drawable/ic_moto"
        app:tint="@color/blanco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:text="@string/app_name"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCorreoAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_s" />

</LinearLayout>
